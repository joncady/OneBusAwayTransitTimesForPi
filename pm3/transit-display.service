[Unit]
Description=Transit display and card photo albums
Requires=init-rc.service
RequiresMountsFor=/init
After=init-rc.service network.target
Conflicts=transit-prototype.service
ConditionPathExists=/init/transit-prototype/autostart.enabled
ConditionPathExists=/init/efad/mp_sd/autorun.sh
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/init/transit-prototype
ExecStart=/init/transit-prototype/start-display.sh
Restart=on-failure
RestartSec=10
TimeoutStopSec=25
KillSignal=SIGTERM
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
